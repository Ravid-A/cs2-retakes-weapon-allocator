<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RetakesAllocator</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>$(MSBuildProjectDirectory)/build\addons\counterstrikesharp\plugins\RetakesAllocator\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PanoramaManagerVersion>0.1.2</PanoramaManagerVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.373" />
    <PackageReference Include="MySqlConnector" Version="2.6.0" />
    <PackageReference Include="RetakesPluginShared" Version="2.0.0" />
    <PackageReference Include="PanoramaManager" Version="$(PanoramaManagerVersion)" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="System.Linq.Async" Version="7.0.1" />
  </ItemGroup>

  <!-- PanoramaManager reads its signatures from the server's shared gamedata folder, not the
       plugin's own, so it has to land beside the plugins directory rather than inside it. Without
       the file the library falls back to signatures compiled in from one CS2 build, which stop
       working at the next update with nothing rendering and no obvious reason why. -->
  <Target Name="CopyPanoramaGameData" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)panoramamanager/$(PanoramaManagerVersion)/contentFiles/any/any/gamedata/panoramamanager.json"
          DestinationFolder="$(MSBuildProjectDirectory)/build/addons/counterstrikesharp/gamedata/"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
